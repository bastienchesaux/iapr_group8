     "output_type": "display_data"
    }
   ],
   "source": [
    "show_figure(\"../data/data_lab_03/part_02/wsi.png\",\"Fig2: WSI classification pipeline.\",(15,4))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f13bf60f",
